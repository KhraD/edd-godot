[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_32 =     "res://../rust/target/i686-unknown-linux-gnu/debug/libgdext_rust.so"
linux.release.x86_32 =   "res://../rust/target/i686-unknown-linux-gnu/release/libgdext_rust.so"
linux.debug.x86_64 =     "res://../rust/target/x86_64-unknown-linux-gnu/debug/libgdext_rust.so"
linux.release.x86_64 =   "res://../rust/target/x86_64-unknown-linux-gnu/release/libgdext_rust.so"
linux.debug.arm64 =      "res://../rust/target/aarch64-unknown-linux-gnu/debug/libgdext_rust.so"
linux.release.arm64 =    "res://../rust/target/aarch64-unknown-linux-gnu/release/libgdext_rust.so"
windows.debug.x86_64 =   "res://../rust/target/x86_64-pc-windows-gnu/debug/gdext_rust.dll"
windows.release.x86_64 = "res://../rust/target/x86_64-pc-windows-gnu/release/gdext_rust.dll"
windows.debug.x86_32 =   "res://../rust/target/i686-pc-windows-gnu/debug/gdext_rust.dll"
windows.release.x86_32 = "res://../rust/target/i686-pc-windows-gnu/release/gdext_rust.dll"
web.debug.wasm32 =       "res://../rust/target/wasm32-unknown-emscripten/debug/gdext_rust.wasm"
web.release.wasm32 =     "res://../rust/target/wasm32-unknown-emscripten/release/gdext_rust.wasm"
android.debug.arm64 =    "res://../rust/target/aarch64-linux-android/debug/libgdext_rust.so"
android.release.arm64 =  "res://../rust/target/aarch64-linux-android/release/libgdext_rust.so"
android.debug.arm32 =    "res://../rust/target/armv7-linux-androideabi/debug/libgdext_rust.so"
android.release.arm32 =  "res://../rust/target/armv7-linux-androideabi/release/libgdext_rust.so"
android.debug.x86_64 =   "res://../rust/target/x86_64-linux-android/debug/libgdext_rust.so"
android.release.x86_64 = "res://../rust/target/x86_64-linux-android/release/libgdext_rust.so"
